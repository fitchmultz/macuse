{
  "name": "macuse",
  "version": "0.6.1",
  "private": true,
  "description": "Guarded native macOS Computer Use with persistent JavaScript for Pi and MCP clients.",
  "type": "module",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "extension",
    "macuse",
    "codex",
    "computer-use",
    "macos",
    "automation"
  ],
  "files": [
    "extensions",
    "lib",
    "tools",
    "configs",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "skills"
  ],
  "bin": {
    "macuse": "tools/macuse.mjs",
    "macuse-mcp": "tools/macuse-mcp.mjs",
    "macuse-doctor": "tools/macuse-doctor.mjs",
    "macuse-repair": "tools/macuse-repair.mjs",
    "macuse-demo": "tools/macuse-demo.mjs",
    "macuse-config": "tools/macuse-config.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/macuse.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "lint": "oxlint --deny-warnings .",
    "lint:agent": "oxlint --deny-warnings --format=agent .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "qualify:engineering": "node tools/qualify-engineering-standard.mjs",
    "doctor": "node tools/macuse-doctor.mjs",
    "doctor:full": "node tools/macuse-doctor.mjs --full",
    "repair": "node tools/macuse-repair.mjs",
    "repair:apply": "node tools/macuse-repair.mjs --apply",
    "demo": "node tools/macuse-demo.mjs",
    "config:cursor": "node tools/macuse-config.mjs cursor --pretty",
    "validate": "node tools/validate-macuse.mjs quick",
    "validate:read-only": "node tools/validate-macuse.mjs read-only",
    "validate:mutating": "node tools/validate-macuse.mjs mutating",
    "validate:focus": "node tools/validate-macuse.mjs focus",
    "validate:mcp": "node tools/validate-macuse.mjs mcp",
    "check:compat": "node tools/check-compat.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.declarations.json",
    "test": "node --test tools/tests/*.test.mjs",
    "ci": "npm run check:compat && node tools/validate-macuse.mjs quick",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "packageManager": "npm@12.2.1",
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "24.19.1",
    "jiti": "2.7.0",
    "oxc-parser": "0.156.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
