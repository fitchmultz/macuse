{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>fitchmultz/.github:pi-extensions"],
  "packageRules": [
    {
      "description": "Keep Node types aligned with the Node 24 runtime target.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "24.x"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/ci\\.yml$/"],
      "matchStrings": ["FORK_REF: (?<currentDigest>[a-f0-9]{40})"],
      "currentValueTemplate": "main",
      "depNameTemplate": "fitchmultz/pi",
      "packageNameTemplate": "https://github.com/fitchmultz/pi",
      "datasourceTemplate": "git-refs"
    }
  ]
}
